#!/usr/bin/env python3
"""List an Infisical project's folders and secret names, with comments when available.

Values are never printed: they come back from `infisical export` but are dropped while
parsing. Authentication reuses whatever the local infisical CLI already has (login
session, INFISICAL_TOKEN, or machine identity), so no token needs to be exported by hand.
"""

from __future__ import annotations

import argparse
import json
import posixpath
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from typing import Any


@dataclass
class ListingError(Exception):
    operation: str
    path: str
    exit_code: int | None = None


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="List Infisical folders, secret names, and comments without values."
    )
    parser.add_argument("--project-id", required=True, help="Infisical project ID")
    parser.add_argument("--env", required=True, help="Infisical environment slug")
    parser.add_argument("--path", default="/", help="Root folder to inspect (default: /)")
    parser.add_argument("--domain", help="Infisical domain; defaults to CLI profile/config")
    return parser.parse_args()


def normalize_path(path: str) -> str:
    normalized = posixpath.normpath("/" + path.lstrip("/"))
    return normalized if normalized != "." else "/"


def run_json(args: list[str], operation: str, path: str) -> list[dict[str, Any]]:
    result = subprocess.run(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if result.returncode:
        raise ListingError(operation, path, result.returncode)

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ListingError(operation, path) from error

    if payload is None:
        return []
    if not isinstance(payload, list):
        raise ListingError(operation, path)
    return [item for item in payload if isinstance(item, dict)]


def base_command(config: argparse.Namespace) -> list[str]:
    command = [
        "infisical",
        "--projectId",
        config.project_id,
        "--env",
        config.env,
        "--silent",
    ]
    if config.domain:
        command.extend(["--domain", config.domain])
    return command


def list_secrets(config: argparse.Namespace, path: str) -> list[tuple[str, str]]:
    try:
        payload = run_json(
            [
                *base_command(config),
                "export",
                "--format",
                "json",
                "--path",
                path,
                "--expand=false",
                "--include-imports=false",
            ],
            "secret listing",
            path,
        )
        return sorted(
            (item["key"], item["comment"] if isinstance(item.get("comment"), str) else "")
            for item in payload
            if isinstance(item.get("key"), str)
        )
    except ListingError:
        payload = run_json(
            [
                *base_command(config),
                "secrets",
                "--path",
                path,
                "--output",
                "json",
                "--expand=false",
                "--include-imports=false",
            ],
            "secret listing",
            path,
        )
        return sorted(
            (item["secretKey"], "")
            for item in payload
            if isinstance(item.get("secretKey"), str)
        )


def list_child_paths(config: argparse.Namespace, path: str) -> list[str]:
    payload = run_json(
        [
            *base_command(config),
            "secrets",
            "folders",
            "get",
            "--path",
            path,
            "--output",
            "json",
        ],
        "folder listing",
        path,
    )
    return sorted(
        normalize_path(f"{path}/{item['folderName']}")
        for item in payload
        if isinstance(item.get("folderName"), str) and "/" not in item["folderName"]
    )


def main() -> int:
    config = parse_args()
    root = normalize_path(config.path)
    tree: dict[str, list[tuple[str, str]]] = {}
    pending = [root]
    visited: set[str] = set()

    with ThreadPoolExecutor(max_workers=8) as executor:
        while pending:
            current = sorted(set(pending) - visited)
            pending = []
            visited.update(current)
            folder_jobs = {
                executor.submit(list_child_paths, config, path): path for path in current
            }
            secret_jobs = {
                executor.submit(list_secrets, config, path): path for path in current
            }

            for job, path in secret_jobs.items():
                tree[path] = job.result()
            for job, path in folder_jobs.items():
                tree.setdefault(path, [])
                pending.extend(job.result())

    def print_tree(path: str, depth: int) -> None:
        indent = "  " * depth
        print(f"{indent}[{path}]")
        for secret_name, comment in tree[path]:
            suffix = f" — {comment}" if comment else ""
            print(f"{indent}  {secret_name}{suffix}")
        children = sorted(
            candidate
            for candidate in tree
            if candidate != path and posixpath.dirname(candidate) == path
        )
        for child in children:
            print_tree(child, depth + 1)

    print_tree(root, 0)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ListingError as error:
        location = f" for {error.path}" if error.path else ""
        status = f" (exit {error.exit_code})" if error.exit_code is not None else ""
        print(f"Infisical {error.operation} failed{location}{status}.", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        raise SystemExit(130)
